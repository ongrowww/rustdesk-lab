+fn select_rendezvous_servers(
+    executable: &str,
+    explicit_user: &str,
+    product: &str,
+    serial_obsolete: bool,
+    configured: &str,
+    fallback: &[&str],
+) -> Vec<String> {
+    for candidate in [executable, explicit_user, product] {
+        if !candidate.is_empty() {
+            return vec![candidate.to_owned()];
+        }
+    }
+    if serial_obsolete {
+        let configured: Vec<String> = configured
+            .split(',')
+            .filter(|host| host.contains('.'))
+            .map(str::to_owned)
+            .collect();
+        if !configured.is_empty() {
+            return configured;
+        }
+    }
+    fallback.iter().map(|host| (*host).to_owned()).collect()
+}
